rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function knownRole(roleId) {
      return roleId in [
        'yudhishthira',
        'bhima',
        'arjuna',
        'nakula',
        'sahadeva',
        'draupadi',
        'kunti',
        'abhimanyu',
        'ghatotkacha',
        'krishna',
        'subhadra',
        'ekalavya',
        'duryodhana',
        'dushasana',
        'shakuni',
        'karna',
        'ashwatthama',
        'bhishma',
        'dronacharya',
        'dhritarashtra',
        'gandhari',
        'vidura',
        'director',
        'producer',
        'screenwriter',
        'dialogue-writer',
        'music-director',
        'lyricist',
        'cinematographer',
        'editor',
        'costume-designer',
        'production-designer',
        'choreographer',
        'vfx-supervisor'
      ];
    }

    match /apps/mahabharatham/casts/{castId} {
      allow read: if true;
      allow create, update: if castId.matches('^[0-9a-fA-F-]{36}$')
        && request.resource.data.keys().hasOnly(['selections', 'createdAt', 'updatedAt'])
        && request.resource.data.selections is map
        && request.resource.data.selections.size() <= 34
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /apps/mahabharatham/tallies/{roleId} {
      allow read: if true;
      allow create, update: if knownRole(roleId)
        && request.resource.data.keys().hasOnly(['total', 'choices', 'top'])
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.choices is map
        && request.resource.data.top is list
        && request.resource.data.top.size() <= 8;
      allow delete: if false;
    }
  }
}
